---
import { school } from "@/config/site";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);

const links = [
  { href: "/", label: "Home" },
  { href: "/brushup", label: "ATPL(A) Brush-up" },
  { href: "/exam", label: "Book an Exam" },
];
---

<header
  class="sticky top-0 z-40 w-full border-b border-border/70 bg-background/80 backdrop-blur supports-[backdrop-filter]:bg-background/60"
>
  <div
    class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6"
  >
    <a href="/" class="flex items-center gap-2.5">
      <span
        class="grid h-9 w-9 place-items-center rounded-lg bg-primary text-primary-foreground shadow-sm"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="h-5 w-5"
        >
          <path
            d="M21 16v-2l-8-5V3.5A1.5 1.5 0 0 0 11.5 2 1.5 1.5 0 0 0 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z"
          ></path>
        </svg>
      </span>
      <span class="flex flex-col leading-none">
        <span class="text-sm font-semibold tracking-tight">{school.name}</span>
        <span
          class="text-[0.68rem] tracking-widest text-muted-foreground uppercase"
        >
          {school.tagline}
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              "rounded-md px-3 py-2 text-sm font-medium transition-colors",
              isActive(l.href)
                ? "bg-accent text-accent-foreground"
                : "text-muted-foreground hover:bg-accent/60 hover:text-foreground",
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/brushup"
        class="hidden rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 sm:inline-flex"
      >
        Register
      </a>
    </div>
  </div>
</header>
